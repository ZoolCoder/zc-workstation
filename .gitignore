/bin/
/dist/
.DS_Store
coverage.out

# The live config: each user keeps their own.
/zc-workstation.yaml
*.secrets
*.pem
.env
.dev.vars

# A binary built with a bare `go build`. Anchored: a bare name would also hide
# every new file under cmd/zc-workstation/.
/zc-workstation

# docs toolchain
/node_modules/
/build/
/.cache/
# Ruby gems for the PDF build. Not vendor/: Go would treat it as a vendor
# directory.
/.bundle/

# plugin eval runs
/evals/results/

/design/
.webscan/

# local workspace: links unpublished sibling modules
go.work
go.work.sum

# rendered wallpapers; assets/wallpaper/render.sh draws them
/assets/wallpaper/*.png
